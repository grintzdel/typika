{
  "extends": "@typika/config/tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "typescript": ["./node_modules/typescript-6"]
    }
  },
  "include": ["src", "server", "vite", "scripts", "*.config.ts"]
}
