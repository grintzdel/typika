+//go:build js
+
+package gocommand
+
+import (
+	"fmt"
+	"io"
+	"syscall/js"
+)
+
+func init() {
+	jsGoCommand = func(args []string, dir string, env []string, stdout, stderr io.Writer) error {
+		jsArgs := make([]any, len(args))
+		for k, a := range args {
+			jsArgs[k] = a
+		}
+		jsEnv := make([]any, len(env))
+		for k, e := range env {
+			jsEnv[k] = e
+		}
+		r := js.Global().Call("goplsGoCommand", js.ValueOf(jsArgs), dir, js.ValueOf(jsEnv))
+		io.WriteString(stdout, r.Get("stdout").String())
+		io.WriteString(stderr, r.Get("stderr").String())
+		if code := r.Get("code").Int(); code != 0 {
+			return fmt.Errorf("exit status %d", code)
+		}
+		return nil
+	}
+}
